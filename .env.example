# Server
PORT=8080

# --- Firebase Admin (server) ---
# On Cloud Run: leave GOOGLE_APPLICATION_CREDENTIALS unset; ADC uses the service account.
# Locally: set GOOGLE_APPLICATION_CREDENTIALS to a downloaded service account JSON.
FIREBASE_PROJECT_ID=road-trip-service
GOOGLE_APPLICATION_CREDENTIALS=

# Firestore database ID. Leave blank to use (default), the Firebase Console convention.
# Set to a custom ID only if Firestore was created with a custom name via the GCP Console.
FIRESTORE_DATABASE_ID=road-trip-db

# --- Firebase client config (frontend) ---
# JSON string from Firebase console: Project Settings → General → Your apps → Web app → SDK setup
FIREBASE_CLIENT_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# --- Google Maps JS API key (frontend) ---
# Restrict by HTTP referrer in GCP console (Cloud Run URL + http://localhost:8080)
GOOGLE_MAPS_API_KEY=

# --- App ownership / access ---
# Owner email — controls client-side admin link visibility (server still verifies on every admin route)
ADMIN_EMAIL=emanuel.palacio@gmail.com

# Allowlist (comma-separated). Leave blank to open the site to any Google account.
# In private beta, restrict to your own email.
ALLOWED_EMAILS=emanuel.palacio@gmail.com

# --- Plan trip limits (server enforces) ---
# Both plans are capped — Free gets 2, Pro gets 10. Per-user overrides
# can be set in Firestore via `users/{uid}.tripLimit` (admin only).
FREE_TRIP_LIMIT=2
PRO_TRIP_LIMIT=10

# --- Booking.com affiliate (optional) ---
# Appended to hotel-search URLs as `aid=`. Leave blank if unset — links
# still work, just without affiliate tracking.
BOOKING_AFFILIATE_ID=

# --- Local dev impersonation (LOCALHOST ONLY) ---
# When set, the server exposes POST /api/dev/auth/impersonate which mints
# a Firebase custom token for this UID. The Login page also shows a
# "Dev sign-in (localhost)" button. Lets headless/test browsers (Chrome
# DevTools MCP, Playwright) sign in without Google's popup flow.
#
# Triple-gated — the route is NOT mounted when any hosted-env signal is
# present (K_SERVICE, DYNO, FLY_APP_NAME, RAILWAY_ENVIRONMENT, or
# NODE_ENV=production). Even if accidentally set in production, the
# loopback-IP check rejects non-localhost callers. Find your UID in the
# Firebase Console → Authentication → Users tab.
DEV_IMPERSONATE_UID=
