rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Default: deny everything ────────────────────────────────────────
    // The Express API uses the Firebase Admin SDK which bypasses these
    // rules entirely. The client SDK is only used for Authentication —
    // all reads/writes go through the backend. So there's no legitimate
    // path for a client to talk directly to Firestore. These rules are
    // defense-in-depth: even if an attacker steals the public web API
    // key from /config, they still can't read another user's trips.
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Users: own record only ─────────────────────────────────────────
    // A user can read their own user doc (e.g., to see plan/tripLimit).
    // Writes are restricted to the server (Admin SDK) — the client should
    // never overwrite plan, tripLimit, or other server-managed fields.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // ─── Trips: server-only ─────────────────────────────────────────────
    // All trip + pin reads/writes go through the Express API (Admin SDK,
    // which bypasses these rules). Direct client access is deliberately
    // denied: a previous allow block here let any authenticated Firebase
    // user create trips (bypassing the server-side trip limit and the
    // email allowlist) and let collaborators rewrite ownerUid/shareToken/
    // isTemplate — none of which the server permits. The catch-all deny
    // above covers trips/{tripId} and its pins subcollection.
  }
}
